<?xml version="1.0" encoding="utf-8"?>
<!--
  三個分頁（底部分頁列切換，設定精靈進行中時只有首頁）：
  首頁 pageHome：狀態卡（主開關、側邊欄服務與備用方式、測試）、怎麼用、設定精靈、讓它更穩定
  設定 pageSettings：通知外觀（含群組頭貼）、LINE 通知清理、側邊欄收哪些 App／外觀、Peek 條、其他開啟方式、其他（可收合）
  說明 pageHelp：常見問題（分三組：側邊欄與 Peek 條、通知、收不到訊息）、遇到問題（回報與診斷記錄）、頁尾連結
  文字與顯示狀態都由 MainActivity.refresh() 控制。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- ===================== 首頁分頁 ===================== -->
        <LinearLayout android:id="@+id/pageHome"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- ===================== 1. 狀態卡 ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="16dp" android:paddingBottom="16dp"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <View android:id="@+id/statusDot"
                    android:layout_width="12dp" android:layout_height="12dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_dot"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/statusSummary"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/statusSub" style="@style/Hint"
                android:layout_marginTop="4dp" android:layout_marginBottom="0dp"
                android:visibility="gone" />
            <!-- Sidepeek 不能發通知時：說明目前先保留 LINE 原本的通知（Notifier.canRepost）。 -->
            <TextView android:id="@+id/statusRepost" style="@style/Status"
                android:visibility="gone"
                android:text="@string/ui_status_repost" />
            <Button android:id="@+id/btnRepostFix" style="@style/Btn"
                android:visibility="gone"
                android:text="@string/ui_btn_repost_fix" />
            <!-- 側邊欄設定被延後時（例如通話中無法允許受限設定）：留一個待辦，隨時回來接著設定。 -->
            <TextView android:id="@+id/statusA11yLater" style="@style/Status"
                android:visibility="gone"
                android:text="@string/ui_status_a11y_later" />
            <Button android:id="@+id/btnResumeA11y" style="@style/Btn"
                android:visibility="gone"
                android:text="@string/ui_btn_resume_a11y" />
            <!-- GitHub Releases 有較新的版本時（UpdateChecker）。 -->
            <TextView android:id="@+id/statusUpdate" style="@style/Status"
                android:visibility="gone" />
            <Button android:id="@+id/btnUpdate" style="@style/Btn"
                android:visibility="gone"
                android:text="@string/ui_btn_update" />
            <!-- 主開關：精靈完成後才出現在狀態卡裡 -->
            <LinearLayout android:id="@+id/mainSwitches"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
            <View style="@style/Divider" android:layout_marginTop="12dp" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swEnabled" style="@style/Sw"
                android:minHeight="56dp" android:textSize="17sp"
                android:text="@string/ui_sw_enabled" />
            <!-- 隱藏原本：併入主開關，保留 id 以免舊邏輯找不到 -->
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swHide" style="@style/Sw"
                android:visibility="gone"
                android:text="@string/ui_sw_hide" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swEdge" style="@style/Sw"
                android:minHeight="56dp" android:textSize="17sp"
                android:text="@string/ui_sw_edge" />

            <!-- 側邊欄開著、但側邊欄服務還沒開時才出現（正確順序：先試開服務） -->
            <LinearLayout android:id="@+id/a11yBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <TextView android:id="@+id/statusA11y" style="@style/Status" android:textStyle="bold" />
                <!-- 「為什麼？」連到說明頁對應的那一題（MainActivity.openFaqQuestion） -->
                <TextView android:id="@+id/whyA11y" style="@style/WhyLink" android:text="@string/ui_why_a11y" />
                <Button android:id="@+id/btnA11y" style="@style/Btn" android:minHeight="56dp"
                    android:textSize="16sp" android:textStyle="bold"
                    android:text="@string/ui_btn_a11y" />
                <Button android:id="@+id/btnA11yAppInfo" style="@style/Btn" android:minHeight="56dp"
                    android:textSize="16sp" android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:text="@string/ui_btn_a11y_app_info" />
                <TextView style="@style/Status"
                    android:textSize="15sp" android:textStyle="bold"
                    android:paddingTop="6dp"
                    android:text="@string/ui_home_1" />
                <TextView style="@style/Hint"
                    android:text="@string/ui_home_2" />
                <TextView android:id="@+id/statusOverlay" style="@style/Status" />

                <!-- 備用方式：側邊欄服務已開時整塊隱藏 -->
                <LinearLayout android:id="@+id/backupBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:id="@+id/txtBackupTitle" style="@style/Label"
                        android:text="@string/ui_txt_backup_title" />
                    <Button android:id="@+id/btnOverlay" style="@style/Btn" android:text="@string/ui_btn_overlay" />
                    <Button android:id="@+id/btnFgsChannel" style="@style/BtnOutline" android:text="@string/ui_btn_fgs_channel" />
                    <TextView android:id="@+id/txtBackupHint" style="@style/Hint"
                        android:text="@string/ui_txt_backup_hint" />
                </LinearLayout>
            </LinearLayout>

            <!-- 長圖文導覽已移入設定精靈；此處保留空殼以免舊程式碼找不到 id -->
            <LinearLayout android:id="@+id/a11yGuideBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">
                <Button android:id="@+id/btnTest" style="@style/BtnOutline"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginEnd="8dp" android:minHeight="52dp"
                    android:text="@string/ui_btn_test" />
                <Button android:id="@+id/btnOpenPanel" style="@style/BtnOutline"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/ui_btn_open_panel" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== 怎麼用（精簡總覽；精靈完成後才顯示） ===================== -->
        <LinearLayout android:id="@+id/howtoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="16dp" android:paddingBottom="16dp"
            android:layout_marginBottom="12dp">

            <TextView style="@style/Section" android:text="@string/ui_home_3" android:layout_marginTop="0dp" />

            <!-- 三個步驟的示意動畫（StepDemoView tag=how）：通知收成對話、邊緣的 Peek 條、往內滑打開側邊欄 -->
            <app.sidepeek.StepDemoView android:tag="how"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- ===================== 2. 設定精靈（一次一步） ===================== -->
        <LinearLayout android:id="@+id/wizardCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="16dp" android:paddingBottom="16dp"
            android:layout_marginBottom="12dp">

            <TextView android:id="@+id/wizardProgress" style="@style/Hint"
                android:textSize="14sp" android:alpha="0.9"
                android:text="@string/ui_wizard_progress" />
            <TextView style="@style/Section"
                android:text="@string/ui_home_6" android:layout_marginTop="4dp" />

            <ImageView android:id="@+id/wizardImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxHeight="360dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/ui_wizard_image_content_description" />

            <!-- 系統設定那幾步：操作示範影片（自動循環、無聲，點一下放大） -->
            <app.sidepeek.GuideVideoView android:id="@+id/wizardVideo"
                android:layout_width="wrap_content"
                android:layout_height="400dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView android:id="@+id/wizardTitle" style="@style/Status"
                android:textSize="18sp" android:textStyle="bold"
                android:paddingTop="12dp"
                android:text="@string/ui_wizard_title" />
            <TextView android:id="@+id/wizardHint" style="@style/Hint"
                android:textSize="15sp" android:alpha="0.9"
                android:lineSpacingExtra="3dp"
                android:text="@string/ui_wizard_hint" />

            <!-- 保留舊 id，給 refresh()／診斷用；畫面不顯示 -->
            <TextView android:id="@+id/statusAccess" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/statusListener" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/statusPost" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btnAccess" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btnRebind" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btnPost" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btnSkipSetup" android:visibility="gone"
                android:layout_width="0dp" android:layout_height="0dp" />

            <Button android:id="@+id/wizardPrimary" style="@style/Btn"
                android:minHeight="56dp" android:textSize="17sp" android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:text="@string/ui_wizard_primary" />
            <Button android:id="@+id/wizardSecondary" style="@style/BtnOutline"
                android:minHeight="48dp" android:textSize="15sp"
                android:visibility="gone"
                android:text="@string/ui_wizard_secondary" />
            <Button android:id="@+id/wizardSkip" style="@style/BtnText"
                android:minHeight="48dp" android:textSize="15sp"
                android:visibility="gone"
                android:text="@string/ui_wizard_skip" />
        </LinearLayout>

        <!-- ===================== 3. 控制台 ===================== -->
        <LinearLayout android:id="@+id/dashGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



            <!-- 建議設定：還有沒做的才出現 -->
            <LinearLayout android:id="@+id/cardSuggest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="16dp" android:paddingBottom="16dp"
                android:layout_marginBottom="12dp">

                <TextView style="@style/Section" android:text="@string/ui_suggest_1" />
                <TextView style="@style/Hint"
                    android:text="@string/ui_suggest_2" />
                <TextView android:id="@+id/whySuggest" style="@style/WhyLink" android:text="@string/ui_why_suggest" />

                <TextView android:id="@+id/statusLineMute" style="@style/Status" android:paddingTop="8dp" />
                <Button android:id="@+id/btnLineMute" style="@style/Btn" android:text="@string/ui_btn_line_mute" />
                <Button android:id="@+id/btnLineMuteDone" style="@style/BtnOutline" android:text="@string/ui_btn_line_mute_done" />

                <TextView android:id="@+id/statusBattery" style="@style/Status" android:paddingTop="12dp" />
                <Button android:id="@+id/btnBattery" style="@style/Btn" android:text="@string/ui_btn_battery" />

                <TextView android:id="@+id/statusNeverSleep" style="@style/Status" android:paddingTop="12dp" />
                <Button android:id="@+id/btnNeverSleep" style="@style/Btn" android:text="@string/ui_btn_never_sleep" />
                <Button android:id="@+id/btnNeverSleepDone" style="@style/BtnOutline" android:text="@string/ui_btn_never_sleep_done" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>

        <!-- ===================== 設定分頁（各區塊預設收合） ===================== -->
        <LinearLayout android:id="@+id/pageSettings"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <!-- 設定分頁是「清單＋子頁面」：平常只顯示 settingsList（圖示、標題、目前設定的摘要），
                 點一項就只顯示那張卡片的內容，最上面是 settingsSubHeader（返回＋標題）。
                 下面的卡片都還在，由 MainActivity.showSettingsList()／openSettingsPage() 切換顯示。 -->
            <TextView android:id="@+id/settingsTitle" style="@style/PageTitle" android:text="@string/ui_settings_title" />
            <TextView android:id="@+id/settingsHint" style="@style/Hint" android:layout_marginBottom="4dp"
                android:text="@string/ui_settings_hint" />
            <LinearLayout android:id="@+id/settingsList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout android:id="@+id/settingsSubHeader"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp" android:visibility="gone">
                <ImageView android:id="@+id/settingsBack"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ui_settings_back_content_description" />
                <TextView android:id="@+id/settingsSubTitle"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="4dp"
                    android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView style="@style/GroupLabel" android:layout_marginTop="4dp" android:text="@string/ui_settings_1" />
            <!-- 通知外觀 -->
            <LinearLayout android:id="@+id/cardLook" style="@style/CollapseCard">
                <TextView android:id="@+id/hdrLook" style="@style/CollapseHeader" />
            <LinearLayout android:id="@+id/grpLook"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <TextView style="@style/SubGroup" android:layout_marginTop="4dp" android:drawableStart="@drawable/ic_sg_brush" android:text="@string/ui_look_1" />
                <TextView style="@style/Label" android:text="@string/ui_look_2" />
                <RadioGroup android:id="@+id/rgNotifStyle" style="@style/SegGroup">
                    <RadioButton android:id="@+id/rbStyleMsg" style="@style/Seg" android:text="@string/ui_rb_style_msg" />
                    <RadioButton android:id="@+id/rbStyleBig" style="@style/Seg" android:text="@string/ui_rb_style_big" />
                    <RadioButton android:id="@+id/rbStyleInbox" style="@style/Seg" android:text="@string/ui_rb_style_inbox" />
                </RadioGroup>

                <TextView style="@style/Label" android:text="@string/ui_look_3" />
                <RadioGroup android:id="@+id/rgNotifMax" style="@style/SegGroup">
                    <RadioButton android:id="@+id/rbMax5" style="@style/Seg" android:text="5" />
                    <RadioButton android:id="@+id/rbMax10" style="@style/Seg" android:text="@string/ui_rb_max10" />
                    <RadioButton android:id="@+id/rbMax25" style="@style/Seg" android:text="25" />
                </RadioGroup>
                <TextView style="@style/Hint"
                    android:text="@string/ui_look_4" />

                <TextView android:id="@+id/lblMsgGap" style="@style/Label" android:text="@string/ui_lbl_msg_gap" />
                <RadioGroup android:id="@+id/rgMsgGap" style="@style/SegGroup">
                    <RadioButton android:id="@+id/rbGapNone" style="@style/Seg" android:text="@string/ui_rb_gap_none" />
                    <RadioButton android:id="@+id/rbGapSmall" style="@style/Seg" android:text="@string/ui_rb_gap_small" />
                    <RadioButton android:id="@+id/rbGapLarge" style="@style/Seg" android:text="@string/ui_rb_gap_large" />
                </RadioGroup>
                <TextView android:id="@+id/hintMsgGap" style="@style/Hint"
                    android:text="@string/ui_hint_msg_gap" />

                <TextView style="@style/Label" android:text="@string/ui_look_5" />
                <!-- 由 MainActivity.setupNotifIconPicker() 填入：內建圖示＋「自訂」 -->
                <LinearLayout android:id="@+id/iconPicker"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginTop="8dp" />
                <TextView style="@style/Hint" android:text="@string/ui_look_6" />
                <TextView style="@style/DetailsToggle" />
                <TextView style="@style/DetailsBody"
                    android:text="@string/ui_look_7" />

                <TextView style="@style/SubGroup" android:drawableStart="@drawable/ic_sg_bell" android:text="@string/ui_look_8" />
                <Button android:id="@+id/btnSound" style="@style/BtnOutline" android:layout_marginTop="8dp" android:text="@string/ui_btn_sound" />
                <TextView style="@style/Hint" android:text="@string/ui_look_9" />
                <TextView style="@style/DetailsToggle" />
                <TextView style="@style/DetailsBody"
                    android:text="@string/ui_look_10" />

                <TextView style="@style/SubGroup" android:drawableStart="@drawable/ic_sg_person" android:text="@string/ui_look_11" />
                <Button android:id="@+id/btnGroupPics" style="@style/BtnOutline" android:layout_marginTop="8dp" android:text="@string/ui_btn_group_pics" />
                <TextView style="@style/Hint"
                    android:text="@string/ui_look_12" />
            </LinearLayout>
            </LinearLayout>

            <!-- LINE 通知清理：什麼時候會自動收掉已讀的 LINE 通知 -->
            <LinearLayout android:id="@+id/cardLineClear" style="@style/CollapseCard">
                <TextView android:id="@+id/hdrLineClear" style="@style/CollapseHeader" />
            <LinearLayout android:id="@+id/grpLineClear"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Hint" android:text="@string/ui_line_clear_1" />
                <!-- 仿真示意動畫：三種清法輪播（StepDemoView tag=clear，文字在 strings.xml 的 demo_*／clear_step*） -->
                <app.sidepeek.StepDemoView android:tag="clear"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swClearOnLine" style="@style/Sw"
                    android:minHeight="56dp" android:layout_marginTop="10dp" android:text="@string/ui_sw_clear_on_line" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swSmartClear" style="@style/Sw"
                    android:minHeight="56dp" android:text="@string/ui_sw_smart_clear" />
                <TextView style="@style/DetailsToggle" />
                <TextView android:id="@+id/hintSmartClear" style="@style/DetailsBody"
                    android:text="@string/ui_hint_smart_clear" />

                <TextView android:id="@+id/statusLineClearA11y" style="@style/Status"
                    android:visibility="gone"
                    android:text="@string/ui_status_line_clear_a11y" />
                <TextView android:id="@+id/whyLineClear" style="@style/WhyLink" android:visibility="gone" android:text="@string/ui_why_a11y" />

            </LinearLayout>
            </LinearLayout>


            <TextView style="@style/GroupLabel" android:text="@string/ui_sw_edge" />
            <!-- 側邊欄：收哪些 App -->
            <LinearLayout android:id="@+id/cardSources" style="@style/CollapseCard">
                <TextView android:id="@+id/hdrSources" style="@style/CollapseHeader" />
            <LinearLayout android:id="@+id/grpSources"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:id="@+id/appSwitches"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <TextView style="@style/Hint" android:text="@string/ui_sources_1" />
                <TextView style="@style/DetailsToggle" />
                <TextView style="@style/DetailsBody"
                    android:text="@string/ui_sources_2" />
            </LinearLayout>
            </LinearLayout>

            <!-- 側邊欄外觀：預覽（往下滑會停在上方）、一列一項的設定、更多設定（收合）、預覽／恢復預設 -->
            <LinearLayout android:id="@+id/cardPanelLook" style="@style/CollapseCard">
                <TextView android:id="@+id/hdrPanelLook" style="@style/CollapseHeader" />
            <LinearLayout android:id="@+id/grpPanelLook"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <!-- 上半部左右兩欄：左邊是縮小的真側邊欄（PanelMiniature），右邊是跟它最相關的寬度、高度、位置，
                     拖的時候眼睛不用上下移動。這一列的高度由 MainActivity.fitSettingsPreview() 撐到剛好一頁放得下。 -->
                <LinearLayout android:id="@+id/panelTopRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="4dp">
                    <app.sidepeek.PanelMiniature
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.42" />
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.58" android:layout_marginStart="8dp"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">
                        <LinearLayout style="@style/StackHead">
                            <TextView android:id="@+id/lblPanelW" style="@style/StackName" />
                            <TextView style="@style/SeekValue" />
                        </LinearLayout>
                        <SeekBar android:id="@+id/sbPanelW" style="@style/Seek" />
                        <LinearLayout style="@style/StackHead">
                            <TextView android:id="@+id/lblPanelH" style="@style/StackName" />
                            <TextView style="@style/SeekValue" />
                        </LinearLayout>
                        <SeekBar android:id="@+id/sbPanelH" style="@style/Seek" />
                        <LinearLayout style="@style/StackHead">
                            <TextView style="@style/StackName" android:text="@string/ui_panel_look_1" />
                        </LinearLayout>
                        <RadioGroup android:id="@+id/rgPanelPos" style="@style/SegGroup"
