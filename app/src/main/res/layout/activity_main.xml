                        <TextView android:id="@+id/lblPanelR" style="@style/LineName" />
                        <SeekBar android:id="@+id/sbPanelR" style="@style/SeekInline" />
                        <TextView style="@style/SeekValue" />
                    </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swPanelScrim" style="@style/Sw"
                        android:minHeight="56dp" android:text="@string/ui_sw_panel_scrim" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <Button android:id="@+id/btnPanelPreview" style="@style/BtnOutline"
