            </LinearLayout>
            </LinearLayout>

            <!-- 側邊欄：Peek 條樣式（特寫的高度填滿剩下的空間，整頁不用滑） -->
            <LinearLayout android:id="@+id/cardHandle" style="@style/CollapseCard">
                <TextView android:id="@+id/hdrHandle" style="@style/CollapseHeader" />
            <LinearLayout android:id="@+id/grpHandle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <!-- Live close-up of the Peek 條; follows the settings below. Height: MainActivity.fitSettingsPreview. -->
                <app.sidepeek.SettingPreview
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:tag="handle" />
                <TextView style="@style/Hint" android:text="@string/ui_handle_1" />

                <LinearLayout style="@style/SeekLine">
                    <TextView style="@style/LineName" android:text="@string/ui_handle_2" />
                    <RadioGroup android:id="@+id/rgSide" style="@style/SegGroupInline">
                        <RadioButton android:id="@+id/rbRight" style="@style/Seg" android:text="@string/ui_rb_right" />
                        <RadioButton android:id="@+id/rbLeft" style="@style/Seg" android:text="@string/ui_rb_left" />
                    </RadioGroup>
                </LinearLayout>
                <LinearLayout style="@style/SeekLine">
                    <TextView android:id="@+id/lblWidth" style="@style/LineName" />
                    <SeekBar android:id="@+id/sbWidth" style="@style/SeekInline" />
                    <TextView style="@style/SeekValue" />
                </LinearLayout>
                <LinearLayout style="@style/SeekLine">
                    <TextView android:id="@+id/lblHeight" style="@style/LineName" />
                    <SeekBar android:id="@+id/sbHeight" style="@style/SeekInline" />
                    <TextView style="@style/SeekValue" />
                </LinearLayout>
                <LinearLayout style="@style/SeekLine">
                    <TextView android:id="@+id/lblSwipeSens" style="@style/LineName" />
                    <SeekBar android:id="@+id/sbSwipeSens" style="@style/SeekInline" />
                    <TextView style="@style/SeekValue" />
                </LinearLayout>

                <LinearLayout android:id="@+id/grpHandleMore"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" >
                    <LinearLayout style="@style/SeekLine">
                        <TextView android:id="@+id/lblInset" style="@style/LineName" />
                        <SeekBar android:id="@+id/sbInset" style="@style/SeekInline" />
                        <TextView style="@style/SeekValue" />
                    </LinearLayout>
                    <LinearLayout style="@style/SeekLine">
                        <TextView android:id="@+id/lblOpacity" style="@style/LineName" />
                        <SeekBar android:id="@+id/sbOpacity" style="@style/SeekInline" />
                        <TextView style="@style/SeekValue" />
                    </LinearLayout>
                    </LinearLayout>

                <Button android:id="@+id/btnResetHandle" style="@style/BtnOutline" android:layout_marginTop="12dp" android:text="@string/ui_btn_reset_handle" />
            </LinearLayout>
            </LinearLayout>

            <!-- 側邊欄：Peek 條什麼時候顯示（跟長相無關，獨立一張） -->
            <LinearLayout android:id="@+id/cardHandleWhen" style="@style/CollapseCard">
                <TextView android:id="@+id/hdrHandleWhen" style="@style/CollapseHeader" />
            <LinearLayout android:id="@+id/grpHandleWhen"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <!-- 仿真示意動畫：照目前的開關演出效果（StepDemoView tag=when） -->
                <app.sidepeek.StepDemoView android:tag="when"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:layout_marginBottom="8dp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swHomeOnly" style="@style/Sw"
                    android:minHeight="56dp" android:text="@string/ui_sw_home_only" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swHideIme" style="@style/Sw"
                    android:minHeight="56dp" android:text="@string/ui_sw_hide_ime" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swShowOnLock" style="@style/Sw"
                    android:minHeight="56dp" android:text="@string/ui_sw_show_on_lock" />
                <TextView style="@style/Hint" android:text="@string/ui_handle_when_1" />
                <TextView android:id="@+id/statusUsage" style="@style/Status" />
                <TextView android:id="@+id/whyUsage" style="@style/WhyLink" android:visibility="gone" android:text="@string/ui_why_usage" />
                <Button android:id="@+id/btnUsage" style="@style/Btn" android:text="@string/ui_btn_usage" />
            </LinearLayout>
            </LinearLayout>

            <!-- 其他開啟方式：快速設定、側螢幕面板捷徑、桌面小工具 -->
            <LinearLayout android:id="@+id/cardOpen" style="@style/CollapseCard">
                <TextView android:id="@+id/hdrOpen" style="@style/CollapseHeader" />
            <LinearLayout android:id="@+id/grpOpen"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Hint" android:text="@string/ui_open_1" />
                <!-- 仿真示意動畫：快速設定／App 捷徑／桌面小工具（StepDemoView tag=open） -->
                <app.sidepeek.StepDemoView android:tag="open"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
                <Button android:id="@+id/btnAddTile" style="@style/BtnOutline" android:layout_marginTop="12dp" android:text="@string/ui_btn_add_tile" />
                <TextView style="@style/DetailsToggle" />
                <TextView style="@style/DetailsBody" android:text="@string/ui_open_2" />
            </LinearLayout>
            </LinearLayout>

            <TextView style="@style/GroupLabel" android:text="@string/ui_open_3" />
            <!-- 其他 -->
            <LinearLayout android:id="@+id/cardOther" style="@style/CollapseCard">
                <TextView android:id="@+id/hdrOther" style="@style/CollapseHeader" />
            <LinearLayout android:id="@+id/grpOther"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swUpdateCheck" style="@style/Sw"
                android:minHeight="52dp" android:text="@string/ui_sw_update_check" />
            <TextView style="@style/Hint" android:text="@string/ui_other_1" />
            <TextView style="@style/DetailsToggle" />
            <TextView style="@style/DetailsBody"
                android:text="@string/ui_other_2" />
            </LinearLayout>
            </LinearLayout>

            <!-- 語言：跟著系統，或指定 App 的語言（AppCompatDelegate.setApplicationLocales，見 MainActivity.setupLanguage） -->
            <LinearLayout android:id="@+id/cardLanguage" style="@style/CollapseCard">
                <TextView android:id="@+id/hdrLanguage" style="@style/CollapseHeader" />
            <LinearLayout android:id="@+id/grpLanguage"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <RadioGroup android:id="@+id/rgLanguage"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton android:id="@+id/rbLangSystem" style="@style/LangOption" android:text="@string/lang_system" />
                    <RadioButton android:id="@+id/rbLangZh" style="@style/LangOption" android:text="@string/lang_zh" />
                    <RadioButton android:id="@+id/rbLangEn" style="@style/LangOption" android:text="@string/lang_en" />
                    <RadioButton android:id="@+id/rbLangJa" style="@style/LangOption" android:text="@string/lang_ja" />
                    <RadioButton android:id="@+id/rbLangKo" style="@style/LangOption" android:text="@string/lang_ko" />
                </RadioGroup>
                <TextView style="@style/Hint" android:layout_marginTop="8dp" android:text="@string/lang_hint" />
            </LinearLayout>
            </LinearLayout>
            </LinearLayout>

        <!-- ===================== 說明分頁：常見問題、遇到問題、頁尾 ===================== -->
