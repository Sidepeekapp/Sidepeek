                        <RadioButton android:id="@+id/rbTextM" style="@style/Seg" android:text="@string/ui_rb_text_m" />
                        <RadioButton android:id="@+id/rbTextL" style="@style/Seg" android:text="@string/ui_rb_gap_large" />
                    </RadioGroup>
                </LinearLayout>
                <LinearLayout style="@style/SeekLine">
                    <TextView android:id="@+id/lblPanelML" style="@style/LineName" />
