            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:textSize="12sp" android:alpha="0.6"
            android:text="Sidepeek・非官方 App，與 LINE / LY Corporation 無關" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>

