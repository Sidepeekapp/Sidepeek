<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Launchers and Samsung's edge panel list this; targetPackage is the release package. -->
    <shortcut
        android:shortcutId="open_panel"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_open_panel"
        android:shortcutLongLabel="@string/shortcut_open_panel">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.sidepeek"
            android:targetClass="app.sidepeek.OpenPanelActivity" />
    </shortcut>
</shortcuts>
